#--------------------------------------------------------------------
# Science Slam review system — copy to .env and fill in
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

app.baseURL = 'https://scienceslam.example/'
app.forceGlobalSecureRequests = true

# Public base URL printed in badge QR codes: {checkinUrl}/in/{BADGE_ID}
slam.checkinUrl = 'https://scienceslam.example'

# Default display timezone and clock (Admin → Settings overrides these).
# slam.timezone = 'Asia/Kolkata'
# slam.timeFormat = '24h'

database.default.hostname = localhost
database.default.database = slam
database.default.username = slam
database.default.password = change-me
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# Test database (PHPUnit). Never point this at production data: it is wiped.
database.tests.hostname = localhost
database.tests.database = slam_test
database.tests.username = slam
database.tests.password = change-me
database.tests.DBDriver = MySQLi
database.tests.DBPrefix =
database.tests.port = 3306
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_unicode_ci

encryption.key =
cookie.secure = true
